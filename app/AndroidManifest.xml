<?xml version="1.0" encoding="utf-8"?>
<!--
  LeicaMoment LSPosed module - legacy Xposed API (de.robv.android.xposed.IXposedHookLoadPackage).
  Pure programmatic UI: no XML layouts / no app resources required.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nezha.leica.lsposed"
    android:versionCode="16"
    android:versionName="2.5.2">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v2.5.0: force-launch card - read latest photo from MediaStore (runtime requested). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35" />

    <!-- Package visibility (Android 11+): needed to check/launch LegendaryActivity. -->
    <queries>
        <package android:name="com.miui.mediaeditor" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="徕卡一瞬 LSPosed"
        android:supportsRtl="true">

        <!-- Legacy Xposed module metadata (recognized by LSPosed manager for legacy modules). -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="小米徕卡「一瞬/二次增强」门禁绕过（SystemProperties 伪装）+ 小米账号 Cookie 注入。适用 com.miui.mediaeditor / com.miui.gallery。" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="徕卡一瞬 LSPosed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v2.3.0: full-screen Xiaomi login / STS helper (programmatic UI, not exported). -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="小米账号登录 / STS"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Read-only config bridge consumed by the hooked mediaeditor/gallery processes.
             Exported intentionally; all callers are verified by uid/package in
             CookieConfigProvider.call(). -->
        <provider
            android:name=".CookieConfigProvider"
            android:authorities="com.nezha.leica.lsposed.config"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>

</manifest>
