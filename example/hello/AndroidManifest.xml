<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal LSPosed module manifest (legacy Xposed API flavour).

  Required for LSPosed to recognise this APK as a LEGACY module:
    <meta-data android:name="xposedmodule"     android:value="true" />
    <meta-data android:name="xposedminversion"  android:value="82" />
    <meta-data android:name="xposeddescription" android:value="..." />
  (xposedminversion is what LSPosed reads; 82 = classic rovo89 Xposed API 82,
   which LSPosed provides as its legacy compatibility API.)

  The modern LSPosed API needs no manifest metadata; it is selected by
  META-INF/xposed/java_init.list instead (see META-INF/xposed/module.prop).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nezha.leica.lsposed"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:hasCode="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="@string/app_name">

        <!-- ===== legacy Xposed module metadata (read by LSPosed) ===== -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposeddescription" android:value="Leica Moment demo LSPosed module (hello)" />

        <!-- Launcher activity: proves this is a real installable APK -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
